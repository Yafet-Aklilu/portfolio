# -----------------------------------------------------------------------------
# Portfolio AI assistant (server-only)
# Copy to `.env.local` and fill values. NEVER commit real secrets.
# NEVER use NEXT_PUBLIC_ for API keys.
# -----------------------------------------------------------------------------

AI_ASSISTANT_ENABLED=false

# Active provider: stub | groq | gemini
AI_ASSISTANT_PROVIDER=stub

# Model for the active provider (must be available on your account)
# Groq examples: qwen/qwen3.8-27b | openai/gpt-oss-20b | allam-2-7b
# Gemini examples: gemini-flash-lite-latest | gemini-3.1-flash-lite
AI_ASSISTANT_MODEL=

# Provider secrets (server-only)
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional tuning
AI_ASSISTANT_MAX_INPUT_CHARS=2000
AI_ASSISTANT_MAX_HISTORY_MESSAGES=10
AI_ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
AI_ASSISTANT_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# Supabase (projects CMS)
# Project: portfolio — https://supabase.com/dashboard/project/hgnmwexzlmwwupxwrkbe
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: required only for file uploads from /admin (Storage).
# Without it, paste image URLs in the admin form instead.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin login. Must match the row in public.admin_secrets.
ADMIN_PASSWORD=
